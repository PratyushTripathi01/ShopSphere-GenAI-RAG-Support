# =================================================================
# ShopSphere GenAI RAG Support - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# =================================================================

# 1. OpenAI Configuration
# Get your API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# 2. Pinecone Vector Database Configuration
# Get your API key: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=shop-support
PINECONE_NAMESPACE=policies

# 3. RAG Retrieval Parameters
CHUNK_SIZE=300
TOP_K=4

# 4. Server Settings
PORT=3000
